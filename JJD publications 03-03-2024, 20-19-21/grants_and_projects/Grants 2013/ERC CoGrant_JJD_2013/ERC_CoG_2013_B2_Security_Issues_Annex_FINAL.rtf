\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \ab\af0\afs22 \ltrch\fcs0 \f3\fs22\insrsid14309763\charrsid14309763 \loch\af3\dbch\af0\hich\f3 \'b7\tab}All
