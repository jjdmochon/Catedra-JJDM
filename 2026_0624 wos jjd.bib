Author = {Delgado-Gonzalez, Antonio and Robles-Remacho, Agustin and Marin-Romero,
   Antonio and Detassis, Simone and Lopez-Longarela, Barbara and Javier
   Lopez-Delgado, F. and de Miguel-Perez, Diego and Guardia-Monteagudo,
   Juan J. and Antonio Fara, Mario and Tabraue-Chavez, Mavys and
   Pernagallo, Salvatore and Sanchez-Martin, Rosario M. and Diaz-Mochon,
   Juan J.},
Title = {PCR-free and chemistry-based technology for miR-21 rapid detection
   directly from tumour cells},
Journal = {TALANTA},
Year = {2019},
Volume = {200},
Pages = {51-56},
Month = {AUG 1},
Abstract = {miRNAs are well known for being implicated in a myriad of biological
   situations, including those related to serious diseases. Amongst miRNAs,
   miRNA-21 has the spotlight as it is reported to be up -regulated in
   multiple severe pathological conditions, being its quantification a key
   point in medicine. To date, most of the techniques for miRNA
   quantification have shown to be less effective than expected; thus, we
   herein present a novel, rapid, cost-effective, robust and PCR-free
   approach, based on dynamic chemistry, for the identification and
   quantification of miRNA directly from tumour cells using both FACS and a
   fluorescent microplate. This dynamic chemistry novel application
   involves bead based reagents and allows quantifying the number of miR-21
   molecules presented in MDA-MB-468 and H1975 tumour cells.},
