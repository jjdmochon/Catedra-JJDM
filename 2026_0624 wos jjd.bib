   Lopez-Delgado, Francisco J. and Dear, James W. and Ilyine, Hugh and
   Ress, Cristina and Diaz-Mochon, Juan J. and Orte, Angel},
Title = {miR-122 direct detection in human serum by time-gated fluorescence
   imaging},
Journal = {CHEMICAL COMMUNICATIONS},
Year = {2019},
Volume = {55},
Number = {99},
Pages = {14958-14961},
Month = {DEC 25},
Abstract = {A simple method for direct detection of microRNAs (miRs) in human serum
   without the use of polymerase amplification is presented, achieving low
   miR-122 concentrations and importantly, discerning effectively
   single-base sequence mutations. The method is based on the capture of
   target miRs with synthetic peptide nucleic acid oligomers, dynamic
   chemical labelling, separation with quaternary amine microplatforms and
   detection using time-gated fluorescence imaging.},
