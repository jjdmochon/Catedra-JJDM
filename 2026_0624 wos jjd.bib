@article{ WOS:000244497700001,
Author = {Diaz-Mochon, Juan J. and Tourniaire, Guilhem and Bradley, Mark},
Title = {Microarray platforms for enzymatic and cell-based assays},
Journal = {CHEMICAL SOCIETY REVIEWS},
Year = {2007},
Volume = {36},
Number = {3},
Pages = {449-457},
Abstract = {This tutorial review introduces the uninitiated to the world of
   microarrays (or so-called chips) and covers a number of basic concepts
   such as substrates and surfaces, printing and analysis. It then moves on
   to look at some newer applications of microarray technology, which
   include enzyme analysis (notably kinases and proteases) as well as the
   growing enchantment with so-called cell-based microarrays that offer a
   unique approach to high-throughput cellular analysis. Finally, it looks
   forwards and highlights future possible trends and directions in the
   microarray arena.},
