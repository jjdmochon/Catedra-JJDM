@inproceedings{ WOS:000398586307126,
Author = {Sanchez-Martin, R. M. and Orte-Gutierrez, A. and Ruedas-Rama, M. J. and
   Diaz-Mochon, J. J. and Cano-Cortes, V. and Castello, F. and
   Lopez-Delgado, F. J. and Luque-Gonzalez, M. A. and Soria-Gila, M. L. and
   Heslop, W. J.},
Editor = {Chova, LG and Martinez, AL and Torres, IC},
Title = {USE OF LABSKILLS AS A VIRTUAL INTERACTIVE TOOL TO GUARANTY AN EFFICIENT
   LEARNING OF EXPERIMENTAL WORK IN THE CHEMISTRY LAB OF FIRST YEAR
   STUDENTS},
Booktitle = {INTED2015: 9TH INTERNATIONAL TECHNOLOGY, EDUCATION AND DEVELOPMENT
   CONFERENCE},
Series = {INTED Proceedings},
Year = {2015},
Pages = {7843-7849},
Note = {9th International Technology, Education and Development Conference
   (INTED), Madrid, SPAIN, MAR 02-04, 2015},
Abstract = {To maximize the experimental learning process of the students in a
   Chemistry lab, any experimental work requires a prelab learning time in
   which concepts such as security in the lab, good practices and standard
   procedures and protocols use routinely in the Chemistry lab have to be
   introduced to the students. Nowadays, a small period is available to
   explain these concepts to a high and heterogeneous group of students.
   This situation happens in Chemistry Subjects of the first year students
   enrolled in the degree in Food Science and Technology, where the
   students are initiated in the experimental lab practices. We expected
   that by rehearsing key practical skills in a virtual environment before
   lab sessions, the tool builds student confidence in the laboratory.
   Herein our experience from a pilot for the integration of an interactive
   virtual learning tool - LABSKILLS (Learning Science Ltd \& Cengage
   Learning)- into the First Year Course of the degree in Food Science and
   Technology at the University of Granada are presented.},
Publisher = {IATED-INT ASSOC TECHNOLOGY EDUCATION A\& DEVELOPMENT},
Address = {LAURI VOLPI 6, VALENICA, BURJASSOT 46100, SPAIN},
